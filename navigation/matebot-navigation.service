[Unit]
Description=Matebot mapping and navigation appliance
Requires=docker.service pigpiod.service
Wants=network-online.target
After=docker.service pigpiod.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/matebot/develop/matebot-navigation
ExecStartPre=/usr/bin/python3 /home/matebot/develop/matebot-navigation/wait_hardware.py
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=100
TimeoutStopSec=55
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
